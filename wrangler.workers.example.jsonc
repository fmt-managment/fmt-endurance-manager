{
  // Only for a Cloudflare Workers project. For Pages, use the dashboard guide.
  "name": "fmt-endurance-manager",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-07",
  "build": { "command": "npm run build:workers" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "fmt-endurance", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_YOUR_SITE",
    "DISCORD_CLIENT_ID": "REPLACE_WITH_DISCORD_APPLICATION_ID",
    "ADMIN_DISCORD_IDS": "REPLACE_WITH_YOUR_DISCORD_USER_IDS"
  }
}
